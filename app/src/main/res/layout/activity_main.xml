<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

        <TextView
            style="@style/ControlPanel.Section"
            android:text="@string/section_identity" />

        <EditText
            android:id="@+id/user_id_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="username"
            android:hint="@string/hint_user_id"
            android:inputType="text"
            android:singleLine="true" />

        <Button
            android:id="@+id/rc_log_in_button"
            style="@style/ControlPanel.Button"
            android:text="@string/action_rc_log_in" />

        <Button
            android:id="@+id/rc_log_out_button"
            style="@style/ControlPanel.Button"
            android:text="@string/action_rc_log_out" />

        <TextView
            style="@style/ControlPanel.Section"
            android:text="@string/section_purchases" />

        <Button
            android:id="@+id/load_offerings_button"
            style="@style/ControlPanel.Button"
            android:text="@string/action_load_offerings" />

        <!-- One "Buy" button per package of the current offering. -->
        <LinearLayout
            android:id="@+id/packages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/sync_purchases_button"
            style="@style/ControlPanel.Button"
            android:text="@string/action_sync_purchases" />

        <TextView
            style="@style/ControlPanel.Section"
            android:text="@string/section_messages" />

        <Button
            android:id="@+id/check_messages_button"
            style="@style/ControlPanel.Button"
            android:text="@string/action_check_messages" />

        <Button
            android:id="@+id/open_deep_link_button"
            style="@style/ControlPanel.Button"
            android:text="@string/action_open_deep_link" />
    </LinearLayout>
</ScrollView>
